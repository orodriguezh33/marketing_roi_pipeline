# Copia este archivo a .env y completa los valores reales.
# .env está en .gitignore — nunca commitear valores reales.

# --- Fase 1: Postgres fuente (infra/, docker-compose.yml) ---
POSTGRES_DB=olist
# El nombre sugiere un rol de solo lectura, pero es el superusuario que crea la
# imagen oficial de Postgres al arrancar (POSTGRES_USER de docker-library/postgres) --
# no hay un rol separado de mínimo privilegio para Airbyte todavía.
POSTGRES_USER=airbyte_reader
POSTGRES_PASSWORD=
POSTGRES_PORT=5434

# --- Fase 1: pgAdmin (UI de administración de Postgres, docker-compose.yml) ---
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# --- Fase 1: descarga del dataset Olist (infra/postgres/seed_olist.py) ---
# Credenciales de la Kaggle API (https://www.kaggle.com/settings -> API -> Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Fase 1: MotherDuck (destino del warehouse) ---
MOTHERDUCK_TOKEN=

# --- Fase 2: MinIO (gasto de ads, sustituto local de S3, docker-compose.yml) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=ads-spend

# --- Fase 2: Stripe test mode (generators/generate_stripe.py) ---
# Test secret key (sk_test_...) desde https://dashboard.stripe.com/test/apikeys
# Pendiente: falta crear la cuenta Stripe (ver docs/setup/fase2-instalacion.md)
STRIPE_API_KEY=

# --- Fase 2: Google Sheets (generators/generate_budget.py) ---
# Ruta local al JSON del service account (no committear el archivo en sí)
# Pendiente: falta crear el service account (ver docs/setup/fase2-instalacion.md)
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Fase 5: Airflow (airflow/docker-compose.yml) ---
# UID del usuario host, para que los volúmenes montados (logs/dags) no queden root:root.
# En Mac/Linux: AIRFLOW_UID=$(id -u)
AIRFLOW_UID=
# Usuario/password del admin de la UI de Airflow (se crea en el primer arranque).
# Nombres fijados por el entrypoint oficial de la imagen apache/airflow — no renombrar.
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
# Fernet key para cifrar credenciales en la metadata db de Airflow.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Secreto para firmar los JWT internos entre scheduler/dag-processor y el api-server
# (Airflow 3.x, AIRFLOW__API_AUTH__JWT_SECRET). Generar con: openssl rand -hex 32
AIRFLOW_JWT_SECRET=

# --- Fase 5: Airbyte Connection en Airflow (airflow/dags/marketing_roi_pipeline.py) ---
# abctl corre Airbyte en el cluster kind local; la API queda en localhost:8000 en el
# host, y en http://host.docker.internal:8000 desde dentro de los contenedores de Airflow.
AIRBYTE_API_URL=http://host.docker.internal:8000/api/v1
# Credenciales de la UI de Airbyte generadas por `abctl local credentials` (Fase 1) —
# solo sirven para loguearte en http://localhost:8000, NO para la API pública (probado:
# devuelve 401 contra /api/public/v1/*). Se usan únicamente para entrar a la UI y crear
# la Application del siguiente bloque.
AIRBYTE_USERNAME=
AIRBYTE_PASSWORD=
# Credenciales de API (OAuth2 client-credentials) que consume el Airflow Connection
# `airbyte_default` (AirbyteHook usa esto, no AIRBYTE_USERNAME/PASSWORD). Se generan en
# la UI de Airbyte: Settings → Applications → "+ New application".
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
# UUID de cada connection de Airbyte (Fase 2), visible en la URL de la UI al abrir
# la connection (.../connections/<uuid>). Pendiente hasta crear las 4 connections.
AIRBYTE_CONNECTION_ID_POSTGRES=
AIRBYTE_CONNECTION_ID_STRIPE=
AIRBYTE_CONNECTION_ID_S3=
AIRBYTE_CONNECTION_ID_SHEETS=

# --- Fase 5: Slack (observabilidad y alertas, airflow/dags/marketing_roi_pipeline.py) ---
# URL del Incoming Webhook clásico de Slack (https://api.slack.com/messaging/webhooks) —
# no un webhook de Workflow Builder, Slack lo rechaza con workflow_not_published si no
# está publicado. NO la lee el código del DAG: se pega a mano como Password de la
# Airflow Connection `slack_default` (tipo "Slack Webhook") en la UI de Airflow — se
# documenta acá solo para saber qué valor pegar.
SLACK_WEBHOOK_URL=
