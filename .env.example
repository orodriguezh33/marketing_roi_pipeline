# Copia este archivo a .env y completa los valores reales.
# .env está en .gitignore — nunca commitear valores reales.

# --- Fase 1: Postgres fuente (infra/, docker-compose.yml) ---
POSTGRES_DB=olist
POSTGRES_USER=airbyte_reader
POSTGRES_PASSWORD=
POSTGRES_PORT=5434

# --- Fase 1: pgAdmin (UI de administración de Postgres, docker-compose.yml) ---
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# --- Fase 1: descarga del dataset Olist (infra/postgres/seed_olist.py) ---
# Credenciales de la Kaggle API (https://www.kaggle.com/settings -> API -> Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Fase 1: MotherDuck (destino del warehouse) ---
MOTHERDUCK_TOKEN=

# --- Fase 2: MinIO (gasto de ads, sustituto local de S3, docker-compose.yml) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=ads-spend

# --- Fase 2: Stripe test mode (generators/generate_stripe.py) ---
# Test secret key (sk_test_...) desde https://dashboard.stripe.com/test/apikeys
# Pendiente: falta crear la cuenta Stripe (ver docs/setup/fase2-instalacion.md)
STRIPE_API_KEY=

# --- Fase 2: Google Sheets (generators/generate_budget.py) ---
# Ruta local al JSON del service account (no committear el archivo en sí)
# Pendiente: falta crear el service account (ver docs/setup/fase2-instalacion.md)
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
